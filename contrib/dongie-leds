#!/bin/bash
# SPDX-License-Identifier: EUPL-1.2
# dongie-leds — status LEDs for a UZ801 stick, run by dongie-leds.service
#   blue:wan   on = LTE connected | slow blink = searching/registering/connecting | off = modem off/failed
#   green:wlan on = Tailscale running | off = not connected
#   red:power  untouched (stays on)
# Polls every 5 s; only writes to sysfs when a state changes (no flicker).
# Set up 2026-11-24.

BLUE=/sys/class/leds/blue:wan
GREEN=/sys/class/leds/green:wlan
INTERVAL=5

led_on()    { echo none > "$1/trigger"; echo 1 > "$1/brightness"; }
led_off()   { echo none > "$1/trigger"; echo 0 > "$1/brightness"; }
led_blink() { echo timer > "$1/trigger"; echo 300 > "$1/delay_on"; echo 1700 > "$1/delay_off"; }

cleanup() { led_off "$BLUE"; led_off "$GREEN"; exit 0; }
trap cleanup TERM INT

last_blue=""; last_green=""
while true; do
  state=$(mmcli -m any -K 2>/dev/null | awk -F': ' '/^modem.generic.state +:/ {gsub(/ /,"",$2); print $2; exit}')
  case "$state" in
    connected)                                      blue=on ;;
    searching|registered|connecting|enabling|enabled|locked) blue=blink ;;
    *)                                              blue=off ;;
  esac
  if [ "$blue" != "$last_blue" ]; then
    case "$blue" in on) led_on "$BLUE" ;; blink) led_blink "$BLUE" ;; off) led_off "$BLUE" ;; esac
    echo "blue -> $blue (modem state: ${state:-none})"
    last_blue=$blue
  fi

  if tailscale status --peers=false --json 2>/dev/null | grep -q '"BackendState": *"Running"'; then
    green=on
  else
    green=off
  fi
  if [ "$green" != "$last_green" ]; then
    case "$green" in on) led_on "$GREEN" ;; off) led_off "$GREEN" ;; esac
    echo "green -> $green (tailscale)"
    last_green=$green
  fi

  sleep "$INTERVAL"
done
